---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Media from '../../components/Media.astro';
import { getCollection, render } from 'astro:content';
import { byTermDesc, inlineMarkdown, offeringId, type Offering } from '../../lib/teaching';

export async function getStaticPaths() {
  const offerings = (await getCollection('teaching')).sort(byTermDesc);
  return offerings.map((entry) => ({
    params: { id: offeringId(entry) },
    props: { entry, siblings: offerings.filter((o) => o.data.code === entry.data.code) },
  }));
}

interface Props {
  entry: Offering;
  siblings: Offering[];
}

const { entry, siblings } = Astro.props as Props;
const { Content } = await render(entry);
const course = entry.data;

// Only show schedule columns that have something in them for this offering.
const columns = (
  [
    ['date', 'Date'],
    ['topic', 'Topic'],
    ['notes', 'Notes'],
    ['reading', 'Readings & assignments'],
    ['deadline', 'Deadlines'],
    ['event', 'Important dates'],
  ] as const
).filter(([key]) => course.schedule.some((row) => row[key]));
---

<BaseLayout
  title={`${course.code}: ${course.title} (${course.term})`}
  description={`${course.code} ${course.title}, ${course.term}, taught by Dr. Yu Zhang at Arizona State University.`}
>
  <section class="wrap py-14 pb-10">
    <a href="/teaching/" data-pagefind-ignore class="font-sans text-sm font-medium no-underline">&larr; All courses</a>
    <span class="eyebrow mt-6">{course.code} &middot; {course.term}</span>
    <h1>{course.title}</h1>

    <div class="mt-8 grid grid-cols-1 items-start gap-10 md:grid-cols-[minmax(0,1fr)_300px] md:gap-14">
      <div>
        <div class="course-description text-text max-w-[68ch] text-[17px] leading-[1.7]">
          <Content />
        </div>
        {
          course.prerequisites && (
            <p class="text-text max-w-[68ch]">
              <strong class="text-ink">Prerequisites:</strong> <Fragment set:html={inlineMarkdown(course.prerequisites)} />
            </p>
          )
        }
      </div>

      <aside class="course-card">
        {
          course.syllabus && (
            <a href={course.syllabus} class="syllabus-button">
              <i class="fa-solid fa-file-pdf" aria-hidden="true" /> Syllabus (PDF)
            </a>
          )
        }
        <dl class="m-0">
          {
            course.meeting && (
              <div>
                <dt>Class</dt>
                <dd>{course.meeting}</dd>
              </div>
            )
          }
          {
            course.officeHours.length > 0 && (
              <div>
                <dt>Office hours</dt>
                {course.officeHours.map((o) => (
                  <dd>
                    {o.who !== 'Instructor' && <span class="text-ink">{o.who}. </span>}
                    {o.when}
                  </dd>
                ))}
              </div>
            )
          }
          {
            course.staff.length > 0 && (
              <div>
                <dt>Course staff</dt>
                {course.staff.map((person) => (
                  <dd>
                    <span class="text-ink">{person.name}</span>
                    <span class="text-faint"> &middot; {person.role}</span>
                    {person.office && <span class="block">Office: {person.office}</span>}
                    {person.email && (
                      <a href={`mailto:${person.email}`} class="block">
                        {person.email}
                      </a>
                    )}
                  </dd>
                ))}
              </div>
            )
          }
        </dl>
      </aside>
    </div>
  </section>

  {
    course.schedule.length > 0 && (
      <section id="schedule" class="border-rule scroll-mt-6 border-t">
        <div class="wrap py-12">
          <span class="eyebrow">Schedule</span>
          {course.scheduleNote && <p class="meta mt-1 mb-6">{course.scheduleNote}</p>}
          <div class="schedule-scroll">
            <table class="schedule">
              <thead>
                <tr>
                  {columns.map(([, label]) => (
                    <th scope="col">{label}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {course.schedule.map((row) => (
                  <tr>
                    {columns.map(([key]) => (
                      <td class={`col-${key}`} set:html={row[key] ? inlineMarkdown(row[key]!) : ''} />
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )
  }

  {
    course.projects.length > 0 && (
      <section id="projects" class="border-rule scroll-mt-6 border-t">
        <div class="wrap py-12">
          <span class="eyebrow">Student projects</span>
          <h2>Selected project demos</h2>
          <div class="mt-6 grid grid-cols-1 gap-10 md:grid-cols-2">
            {course.projects.map((project) => (
              <article>
                {project.youtube && (
                  <div class="aspect-video">
                    <iframe
                      class="h-full w-full"
                      src={`https://www.youtube-nocookie.com/embed/${project.youtube}`}
                      title={project.title}
                      loading="lazy"
                      allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    />
                  </div>
                )}
                {project.video && (
                  <Media
                    media={{ src: project.video, poster: project.poster, autoplay: false }}
                    alt={project.title}
                    class="aspect-video w-full bg-black"
                    figureClass="m-0 border-0"
                  />
                )}
                <h3 class="mt-4 mb-1.5">{project.title}</h3>
                {project.award && (
                  <p class="m-0 mb-2">
                    <span class="award-tag">
                      <i class="fa-solid fa-trophy" aria-hidden="true" /> {project.award}
                    </span>
                  </p>
                )}
                <p class="text-text">{project.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    siblings.length > 1 && (
      <section class="border-rule border-t">
        <div class="wrap py-12" data-pagefind-ignore>
          <span class="eyebrow">Other semesters of {course.code}</span>
          <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
            {siblings.map((o) => (
              <li>
                <a
                  href={`/teaching/${offeringId(o)}/`}
                  class="term-chip"
                  aria-current={o.id === entry.id ? 'page' : undefined}
                >
                  {o.data.term}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Rendered Markdown (the course description): the site resets list styles globally. */
  .course-description :global(ol),
  .course-description :global(ul) {
    margin: 0 0 1.2em;
    padding-left: 1.4em;
  }
  .course-description :global(ol) {
    list-style: decimal;
  }
  .course-description :global(ul) {
    list-style: disc;
  }
  .course-description :global(li) {
    margin-bottom: 0.4em;
  }
  .course-description :global(strong) {
    color: var(--color-ink);
  }

  .course-card {
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
    background: var(--color-paper);
    padding: 1.5rem;
    font-size: 14px;
    line-height: 1.55;
  }
  .course-card dl > div + div {
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-rule-soft);
  }
  .course-card dt {
    margin-bottom: 0.35rem;
    color: var(--color-maroon);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .course-card dd {
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }
  .course-card dd:last-child {
    margin-bottom: 0;
  }

  .syllabus-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding: 0.65rem 1rem;
    border-radius: 0.375rem;
    background: var(--color-maroon);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s;
  }
  .syllabus-button:hover {
    background: var(--color-maroon-deep);
    color: var(--color-bg);
  }

  /* Wide table scrolls inside its box on phones instead of widening the page. */
  .schedule-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
  }
  .schedule {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.5;
  }
  .schedule th {
    background: var(--color-paper);
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-align: left;
    text-transform: uppercase;
  }
  .schedule th,
  .schedule td {
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--color-rule-soft);
    vertical-align: top;
  }
  .schedule tbody tr:last-child td {
    border-bottom: 0;
  }
  .schedule tbody tr:hover {
    background: var(--color-paper);
  }
  .schedule td {
    color: var(--color-text);
  }
  .schedule .col-date {
    white-space: nowrap;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .schedule .col-topic {
    min-width: 180px;
    color: var(--color-ink);
    font-weight: 500;
  }
  .schedule :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .schedule :global(.reading-tag) {
    display: inline-block;
    margin-right: 0.15rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
  }
  .schedule :global(.reading-tag-required) {
    background: color-mix(in srgb, var(--color-maroon) 14%, transparent);
    color: var(--color-maroon);
  }
  .schedule :global(.reading-tag-recommended) {
    background: color-mix(in srgb, var(--color-gold) 18%, transparent);
    color: var(--color-gold);
  }

  .award-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-gold) 18%, transparent);
    color: var(--color-gold);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
  }

  .term-chip {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .term-chip:hover,
  .term-chip[aria-current='page'] {
    border-color: var(--color-maroon);
    color: var(--color-maroon);
  }
</style>
